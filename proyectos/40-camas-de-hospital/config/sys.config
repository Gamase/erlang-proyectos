[
  {p40_camas_de_hospital, [
    %% Demo: 1 minuto del hospital = 100 ms reales -> 1 dia simulado = 2.4 min.
    %% Para operar en tiempo real usa 60000 y {simulacion, false}.
    %% UI y API en http://localhost:8080 (quita la linea para no abrir puerto).
    {puerto, 8080},
    {minuto_ms, 100},
    {simulacion, true},
    {limpieza_min, 45},
    {umbral_alerta, 0.85},
    {prob_alta, 0.7},
    %% Cada cuantos minutos simulados se mata una cama al azar (0 = nunca).
    {falla_cada_min, 360},
    {semilla, {40, 27, 2026}}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
